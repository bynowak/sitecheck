{
  "name": "sitecheck-workspace",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @sitecheck/engine build && pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm --filter @sitecheck/engine build && pnpm --filter sitecheck build && vitest run",
    "dev": "pnpm --filter @sitecheck/engine build && pnpm --filter @sitecheck/web dev",
    "sitecheck": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "prettier": "^3.7.0",
    "vitest": "^5.0.3"
  }
}
